<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Mirrors the library's TFMs so both shipped assemblies are exercised
		     at runtime, not just compiled. The source is TFM-uniform, but each
		     assembly binds to a different BCL and runs on a different runtime —
		     locking, System.Text.Json defaults and file APIs can all differ — so
		     a net10.0-only run leaves the shipped net8.0 assembly untested. -->
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- xUnit.net v3 test projects are self-hosting executables, not
		     libraries loaded by an external runner. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- Opts out of the Directory.Build.props default. Test and fixture code
		     carries no XML docs, and TreatWarningsAsErrors would fail the build
		     over every missing one. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!--
			CA1707 (no underscores in member names) is the xUnit-naming
			convention everyone uses for readable test names like
			Method_WhenCondition_ExpectedResult. Let tests use it.

			CA1515 (internal > public) would flag every xUnit fixture —
			tests need to be public for the runner to discover them.

			CA2007 (ConfigureAwait) doesn't apply in test contexts; there
			is no SynchronizationContext to recapture.
		-->
		<NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Spectre.Console.Testing" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\NextIteration.SpectreConsole.Settings\NextIteration.SpectreConsole.Settings.csproj" />
	</ItemGroup>

</Project>
